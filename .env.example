# Copy to .env (gitignored) on the server and fill in. Start with:
#   node --disable-warning=ExperimentalWarning --env-file=.env server/index.js
# No secrets are needed: users and passwords live in the database, created with the user CLI.

NODE_ENV=production

# Where Node listens. Keep it on loopback and put an HTTPS reverse proxy (nginx, Caddy, IIS) in front.
HOST=127.0.0.1
PORT=8080

# The exact public URL users type (scheme + host, no path, no trailing slash). Required in production;
# requests whose Origin header does not match are rejected (CSRF defence).
PUBLIC_ORIGIN=https://audit.example.com

# Secure, __Host- prefixed session cookie and HSTS. Always on in production; cannot be turned off there.
SECURE_COOKIES=true

# Required in production. true = Node is reachable ONLY through your reverse proxy (the server then trusts
# the rightmost X-Forwarded-For entry, which the proxy adds). false = clients connect to Node directly.
# Used for per-IP sign-in rate limiting.
TRUST_PROXY=true

# Database: EITHER a local SQLite file (own server) ...
# Back this file up (see README). Must be on a local disk, not a network share.
DB_PATH=/var/lib/textile-audit/textile-audit.db
# ... OR a hosted Turso database (required on Vercel). DB_URL wins over DB_PATH when set.
# The token is a secret: keep it in the Vercel project settings or in a gitignored .env.turso, never in git.
# DB_URL=libsql://textile-audit-yourname.turso.io
# DB_AUTH_TOKEN=

# Session lifetime in hours (1-168) and failed sign-ins allowed per user+IP per 15 minutes (3-50).
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
